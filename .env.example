# Copy this file to ".env" and fill in your real values. Never commit .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@case-file.xxxxx.mongodb.net/
VOYAGE_API_KEY=pa-xxxxxxxx

# AI that writes the answers: "gemini" (free tier) or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4.1

# Optional: database name (default: case_file)
MONGODB_DB=case_file
